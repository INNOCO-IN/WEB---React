# The HOSTED project's keys — Supabase → Project Settings → API.
#
# Copy to .env.local (gitignored) and fill in. This file is not what
# `npm run dev` reads: that runs `vite --mode devdb` and talks to the Supabase
# on this machine, whose keys are committed in .env.devdb. What reads .env.local
# is `npm run dev:live`, `npm run build` and `npm run preview` — the three
# commands that are meant to reach the live database.
#
# The anon key is safe in client code as long as RLS is in place; see
# ../schema.sql and ../SUPABASE.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, and only for `npm run signin-link` — the dev helper that prints a
# /review sign-in link instead of mailing one. NO `VITE_` PREFIX: that prefix is
# what puts a variable into the browser bundle, and this key bypasses RLS on
# every table. Nothing under src/ reads it.
#
# The local stack does not need it: it catches its own mail at
# http://127.0.0.1:54324, so the real mailed-link flow works there.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — the CAPTCHA on the /review sign-in form (Cloudflare Turnstile).
#
# PUBLIC by design: the site key identifies the widget and is meant to be read
# by anyone who views source, so the VITE_ prefix is correct here. Get a pair
# from Cloudflare → Turnstile → Add site (free).
#
# **This is one switch in two places.** Its secret pair goes to Supabase, not
# here — `[auth.captcha]` in app/supabase/config.toml for the local stack, or
# Authentication → Settings for a hosted project. If Supabase has CAPTCHA on
# and this is empty, every sign-in fails with "captcha protection: request
# disallowed"; if Supabase has it off, a token is ignored. Set both or neither.
VITE_TURNSTILE_SITE_KEY=

# The secret half, read by `supabase start` via config.toml's env() — NOT by
# Vite, and deliberately without a VITE_ prefix. Only needed for the local
# stack; on a hosted project the secret is entered in the dashboard instead.
SUPABASE_AUTH_CAPTCHA_SECRET=
