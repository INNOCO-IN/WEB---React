# dependencies
node_modules/

# build output
app/dist/
app/.vite/

# local env — real keys live here, never commit.
#
# app/.env.devdb is deliberately NOT here: it holds the local Supabase stack's
# keys, which address 127.0.0.1 and are the same on every machine, and
# committing it is what makes a fresh checkout's `npm run dev` work without
# anyone handing over a credential. Do not widen these to `.env.*`.
.env
.env.local
.env.*.local

# who has admin access is per-deployment, and does not belong in git history.
# app/scripts/supabase-setup.mjs folds this in when it is present.
seed-staff.sql

# tooling / editor state
.DS_Store
Thumbs.db
.vercel/
*.log

# static-site runtime state (see site/image-slot.js)
.image-slots.state.json
.thumbnail

# generated by app/scripts/supabase-setup.mjs — the five parts it concatenates
# are the source of truth, so committing the bundle would double every content diff
supabase-setup.sql

# design drops — a whole exported tree plus its zip, handed over rather than
# merged. They are measured with `npm --prefix app run handoff:check` and taken
# into site/ page by page; the drop itself is ~100 MB and belongs nowhere near
# git history. schema.sql.bak is the same kind of thing at one file's scale.
/Backend/
/New COM/
/handoff/
schema.sql.bak
